# .gitignore for college/class notes on macOS
# - Keeps macOS/system files, editor/project metadata, temporary files,
#   and common secret files out of the repository.
# - Customize the "Optional" sections if you want to track e.g. datasets or
#   notebooks. This file is intentionally conservative for notes projects.

# ---- macOS ----
.DS_Store
*.DS_Store
.AppleDouble
.LSOverride
# Icon must end with two \\\r
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.VolumeIcon.icns

# ---- Editor folders / IDEs ----
.vscode/
.idea/
# JetBrains project files
*.iml

# ---- Swap / backup / temp files ----
*~
*.swp
*.swo
*.swn
# Emacs
*~

# ---- Python / virtualenv (optional; remove if not used) ----
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/

# ---- Jupyter ----
.ipynb_checkpoints/
# If you prefer to ignore notebook outputs, enable the next line.
# *.ipynb

# ---- Logs and coverage ----
*.log
.coverage
coverage.xml
.pytest_cache/

# ---- Secrets and local configuration ----
.env
.env.*
*.pem
*.key
secrets/

# ---- Large data / exports (optional) ----
# Uncomment if you don't want to check in exported data files
# *.csv
# *.tsv
# data/

# ---- Course material binaries (kept locally, not pushed to GitHub) ----
# Note: already-tracked files are unaffected; use `git rm --cached` to untrack.
*.pdf
*.epub
*.docx
*.pptx
*.xlsx

# ---- Misc ----
Thumbs.db
desktop.ini

## LaTeX auxiliary files
*.aux
*.lof
*.lot
*.fls
*.log
*.out
*.toc
*.fmt
*.fot
*.cbl
*.cb2
*.lb
*.bbl
*.blg
*.bcf
*.run.xml
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb

# Local backups
local_backups/

# End of .gitignore
